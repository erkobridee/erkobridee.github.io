{
  "name": "erkobridee.github.io",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "unset:git-hooks-path": "git config --unset core.hooksPath",
    "simple-git-hooks": "npx simple-git-hooks",
    "postinstall": "is-ci || npm run simple-git-hooks",
    "prettier": "prettier --write  \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\"",
    "eslint": "eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "lint": "run-s prettier eslint",
    "tsc": "pnpm exec tsc --noEmit",
    "sync": "astro sync",
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "7.3.2",
    "canvas-confetti": "1.9.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "8.0.1",
    "@astrojs/ts-plugin": "1.10.11",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "astro-favicons": "3.1.6",
    "astro-icon": "1.2.0",
    "autoprefixer": "10.6.1",
    "clsx": "2.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "is-ci": "4.1.0",
    "lint-staged": "17.5.1",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "simple-git-hooks": "2.14.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,md,mdx,astro}": "prettier --write",
    "src/**/*.{js,ts,jsx,tsx,astro}": "eslint --fix"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  }
}
